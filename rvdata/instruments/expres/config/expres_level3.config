[STITCHPARS]
instrument = EXPRES
# Trace selection to stitch (e.g 1-3,4,6)
trace_selection = 1
# Echelle orders for blue segment start (EXPRES orders run 160 blue to 75 red)
echorder_blue_start = 160
# Echelle orders for blue segment end. Leave blank for single flat source
echorder_blue_end =
# Echelle orders for red segment start. Leave blank for single flat source
echorder_red_start =
# Echelle orders for red segment end. Order 75 carries no extracted flux, so
# the stitched product stops at order 76.
echorder_red_end = 76
# Start wavelength (A) of the stitched wavelength grid (order 160 starts at 3797 A)
wavegrid_start = 3800.0
# End wavelength (A) of the stitched wavelength grid (order 76 ends near 8100 A)
wavegrid_end = 8100.0
# Average pixel width in velocity space (m/s): median of c * dlambda / lambda
# over the fitspec wavelength grid is 553 m/s
velpix = 553.0
